// =============================================================================
// PLATAFORMA DE DASHBOARDS/RELATÓRIOS GERADOS POR IA — schema Prisma (MVP)
//
// Decisões travadas (ver docs/plano/30-modelagem-dados.md):
//   - Mono-prefeitura: SEM tabela Organization. A prefeitura é implícita (a
//     própria instância). Visibilidade ORG = prefeitura inteira.
//   - RBAC com role GLOBAL (não escopado por departamento).
//   - SEM histórico de versões: só DRAFT + PUBLISHED nos artefatos (Chart,
//     Dashboard). Não há ChartVersion/DashboardVersion.
//   - SEM AuditLog no MVP.
//   - Chat/Conversas persistidas (Conversation + ChatMessage).
//   - Catálogo de blocos vive EM CÓDIGO (não em tabela). Só o tipo é
//     persistido como string (catalogType).
//   - Cache vive no Redis (não vira tabela).
//   - Conexões externas: SOMENTE Postgres, read-only. Credencial cifrada
//     at-rest (AES-256-GCM) no campo `passwordCipher`.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

/// RBAC global. USER = conta autenticada sem acesso a dashboards (matriz
/// detalhada em docs/plano/01-fundacao-rbac-tenancy.md).
enum UserRole {
  ADMIN
  ANALYST
  CREATOR
  VIEWER
  USER
}

/// Visibilidade aplicável a Connection/Chart/Dashboard.
enum Visibility {
  PRIVATE
  DEPARTMENT
  ORG
}

/// Status corrente do artefato (Chart/Dashboard). Sem histórico — apenas
/// indica o estado vigente. Publish copia draft → published.
enum ArtifactStatus {
  DRAFT
  PUBLISHED
}

/// Tipo da conexão externa (sempre read-only).
///
/// POSTGRES     — TCP direto no Postgres (lib/pg-runner).
/// API_GATEWAY  — HTTP contra um gateway read-only que expõe um banco de outra
///                rede (lib/gateway-runner). Existe porque nem todo banco é
///                alcançável: o TRIBUTARIO_IPATINGA (SQL Server/SIGCORP) vive
///                atrás de VPN, e abrir VPN para cada sistema que precisa ler é
///                caro e arriscado. O gateway é a porta única — a plataforma
///                fala HTTP com ele e continua sem enxergar a rede interna.
enum ConnectionType {
  POSTGRES
  API_GATEWAY
}

/// Ambiente do banco apontado por uma Connection — DECLARADO por quem cadastra,
/// nunca inferido. Existiu uma heurística no front que adivinhava o ambiente
/// procurando "dev"/"local"/"homolog" no nome da conexão e do banco, e caía em
/// "Produção" quando não reconhecia nada. Isso marcava banco de teste como
/// produção e, pior, marcava produção como "Dev" sempre que o nome continha
/// "local" (ex.: `arrecadacao_local`). Numa ferramenta de auditoria o rótulo de
/// ambiente orienta cuidado — então ele passou a ser um dado de verdade.
enum ConnectionEnvironment {
  DEV
  HOMOLOG
  PRODUCTION
}

/// Tipo de alvo de um ShareLink (token público com TTL).
enum ShareTargetType {
  DASHBOARD
  CHART
}

// =============================================================================
// RBAC & TENANCY (mono-prefeitura, role global)
// =============================================================================

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  password    String
  role        UserRole  @default(VIEWER)
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  memberships   DepartmentMembership[]
  connections   Connection[]
  charts        Chart[]
  dashboards    Dashboard[]
  shareLinks    ShareLink[]
  conversations Conversation[]

  @@map("users")
}

/// Departamento/repartição dentro da prefeitura. Plano (sem hierarquia) no MVP.
model Department {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships DepartmentMembership[]
  connections Connection[]
  charts      Chart[]
  dashboards  Dashboard[]

  @@map("departments")
}

/// Vínculo User × Department. Um usuário pode pertencer a N departamentos.
model DepartmentMembership {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  departmentId String   @map("department_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@map("department_memberships")
}

// =============================================================================
// CONEXÕES (Postgres externo, read-only)
// =============================================================================

/// Cadastro de uma conexão a uma fonte de dados externa READ-ONLY. Usada pelo
/// agente (via MCP) e pelo runtime para executar queries. O SEGREDO é sempre
/// cifrado (AES-256-GCM) em `passwordCipher`.
///
/// Dois tipos, um mesmo cadastro (ver enum ConnectionType):
///   - POSTGRES    → host/port/database/username + senha em `passwordCipher`.
///   - API_GATEWAY → `baseUrl` + TOKEN Bearer em `passwordCipher`. Os campos de
///     endereço continuam preenchidos (host/port derivados da URL, `database`
///     preenchido pelo próprio gateway no primeiro teste) para que listagem,
///     busca e telas existentes funcionem sem saber de qual tipo se trata.
///
/// Por que o token mora em `passwordCipher` e não num campo novo: é o campo
/// SEGREDO do registro, com cifragem e omissão da serialização já garantidas e
/// testadas. Um `tokenCipher` paralelo duplicaria essa superfície de risco — e
/// bastaria alguém esquecer de excluí-lo de um `select` para vazar credencial.
model Connection {
  id             String                @id @default(cuid())
  name           String
  description    String?
  type           ConnectionType        @default(POSTGRES)
  host           String
  port           Int                   @default(5432)
  database       String
  username       String
  /// Senha (POSTGRES) ou token Bearer (API_GATEWAY), cifrado at-rest.
  passwordCipher String                @map("password_cipher")
  sslMode        String                @default("require") @map("ssl_mode")
  /// Base URL do gateway (ex.: https://gw.exemplo.com). Só para API_GATEWAY.
  baseUrl        String?               @map("base_url")
  options        Json?
  ownerId        String                @map("owner_id")
  departmentId   String?               @map("department_id")
  visibility     Visibility            @default(DEPARTMENT)
  /// Ambiente declarado no cadastro. O default só serve ao backfill da
  /// migração (linhas antigas viram PRODUCTION — o lado seguro do erro);
  /// a API de criação EXIGE o campo, para ninguém cair num padrão silencioso.
  environment    ConnectionEnvironment @default(PRODUCTION)
  isActive       Boolean               @default(true) @map("is_active")
  /// unknown | ok | error — atualizado por `POST /connections/:id/test`.
  status         String                @default("unknown")
  lastTestedAt   DateTime?             @map("last_tested_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  owner      User        @relation(fields: [ownerId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@map("connections")
}

// =============================================================================
// GRÁFICO (entidade 1ª classe, reusável; DRAFT + PUBLISHED)
// =============================================================================

/// Gráfico/cartão reutilizável, referenciado por um ou mais Dashboards.
/// Catálogo de blocos vive em código; `catalogType` é o identificador do
/// bloco no registry (ex.: "kpi", "bar", "title").
///
/// Publish copia `draft*` → `published*` e seta `publishedAt`. Unpublish zera
/// os campos published. dev mode usa `draft*` (sem cache); published mode usa
/// `published*` (com cache).
model Chart {
  id           String         @id @default(cuid())
  title        String
  catalogType  String         @map("catalog_type")
  ownerId      String         @map("owner_id")
  departmentId String?        @map("department_id")
  visibility   Visibility     @default(PRIVATE)
  status       ArtifactStatus @default(DRAFT)

  /// Cópia de trabalho — sempre editável; usada em dev/sem cache.
  draftProps       Json @map("draft_props")
  /// { connectionId, query, params[], transform, ttlSeconds }
  draftDataBinding Json @map("draft_data_binding")

  /// Cópia publicada — null até o 1º publish; cacheada quando vigente.
  publishedProps       Json?     @map("published_props")
  publishedDataBinding Json?     @map("published_data_binding")
  publishedAt          DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner      User        @relation(fields: [ownerId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@map("charts")
}

// =============================================================================
// DASHBOARD (layout referencia charts; DRAFT + PUBLISHED)
// =============================================================================

/// Dashboard composto por filtros + linhas (seções) + gráficos.
/// O `publishedLayout` referencia `chartId`s (Chart.id) — reuso entre
/// dashboards é permitido.
///
/// draftLayout/publishedLayout: { filters[], rows[] } (ver contrato em
/// docs/plano/20-contrato-dashboard.md).
model Dashboard {
  id           String         @id @default(cuid())
  title        String
  ownerId      String         @map("owner_id")
  departmentId String?        @map("department_id")
  visibility   Visibility     @default(PRIVATE)
  status       ArtifactStatus @default(DRAFT)

  /// URL de um relatório EXTERNO (legado, criado fora desta plataforma).
  /// Quando preenchida, o dashboard é um ATALHO: entra na mesma listagem dos
  /// dashboards montados aqui, mas não tem layout próprio (o `draftLayout` fica
  /// vazio), não abre no editor e não passa por publish — clicar nele leva a
  /// este endereço. `NULL` = dashboard desta plataforma (o caso normal).
  externalUrl String? @map("external_url")

  draftLayout          Json      @map("draft_layout")
  publishedLayout      Json?     @map("published_layout")
  /// Snapshot materializado dos blocos com dados, gerado no publish (T-G1
  /// bugfix do share público). Mesmo shape do batch `POST /dashboards/:id/data`
  /// (`{ dashboardId, mode, generatedAt, blocks }`). Permite que a página
  /// pública anônima `/public/:token` mostre blocos de dados (KPI/gráfico/
  /// tabela) sem precisar executar query ou ter usuário autenticado. Null
  /// até o 1º publish, ou se o dashboard não tem blocos de dados.
  publishedDataPayload Json?     @map("published_data_payload")
  publishedAt          DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner      User        @relation(fields: [ownerId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@map("dashboards")
}

// =============================================================================
// SHARE LINK (TTL a partir da 1ª abertura)
// =============================================================================

/// Link público (sem auth) com TTL contado a partir da 1ª abertura.
/// `firstAccessedAt` é setado na 1ª abertura; `expiresAt` é derivado como
/// `firstAccessedAt + durationSeconds`. Revogação manual zera o ciclo via
/// `revokedAt`.
model ShareLink {
  id              String          @id @default(cuid())
  token           String          @unique
  targetType      ShareTargetType @map("target_type")
  targetId        String          @map("target_id")
  createdById     String          @map("created_by_id")
  durationSeconds Int             @map("duration_seconds")
  firstAccessedAt DateTime?       @map("first_accessed_at")
  expiresAt       DateTime?       @map("expires_at")
  revokedAt       DateTime?       @map("revoked_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  createdBy User @relation(fields: [createdById], references: [id])

  @@map("share_links")
}

// =============================================================================
// CHAT / AGENTE DE IA
// =============================================================================

/// Conversa (sessão de chat). Cada conversa acumula mensagens e tem um título.
/// O userId é o dono da conversa (quem está conversando com o agente).
model Conversation {
  id        String   @id @default(cuid())
  title     String   @default("Nova conversa")
  userId    String   @map("user_id")
  /// Metadados arbitrários em JSON. Hoje: { source: 'whatsapp', phoneNumber,
  /// createdAt, lastInboundMessageId, lastAssistantMessageId, lastReplyAt,
  /// pushName } quando a conversa vem do canal WhatsApp. Null para conversas
  /// criadas pelo app web. Index GIN em `metadata` (migration dedicada).
  metadata  Json?    @map("metadata")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@map("conversations")
}

/// Mensagem de uma conversa. role = user|assistant|tool.
/// content é o texto da mensagem. toolData guarda metadados (tool calls, chart payloads, etc).
/// tokensIn/tokensOut guardam consumo de tokens por mensagem (para análise de custo).
model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  role           String
  content        String   @db.Text
  toolData       Json?    @map("tool_data")
  tokensIn       Int?     @map("tokens_in")
  tokensOut      Int?     @map("tokens_out")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}
